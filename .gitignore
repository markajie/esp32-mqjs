# ---------------------------------------------------------------------------
# ESP-IDF build output and per-build state
# ---------------------------------------------------------------------------
build/
*.log

# sdkconfig is generated per board by CMake:
#   sdkconfig.<vendor>_<board>
# The tracked sources are ./sdkconfig.defaults and each board's
# main/boards/<vendor>/<board>/sdkconfig.defaults.board.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults

# esp_board_manager output, regenerated from the selected board's YAML files
components/gen_bmgr_codes/

# IDF Component Manager cache, restored from dependencies.lock
managed_components/

# Python caches from tools/ and component helper scripts
__pycache__/
*.py[cod]

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
compile_commands.json

# Local rollback snapshots and DSH skill state
backups/
.dsh/
